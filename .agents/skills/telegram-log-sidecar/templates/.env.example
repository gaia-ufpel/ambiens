# --- Telegram log sidecar ---
# Master switch. Set to literal string "true" to enable. Anything else = no-op.
TELEGRAM_LOGS_ENABLED=true

# From @BotFather
TELEGRAM_BOT_TOKEN=

# Chat/group/channel ID (negative for groups/channels). Get via:
#   curl "https://api.telegram.org/bot<TOKEN>/getUpdates" | jq '.result[].message.chat'
TELEGRAM_CHAT_ID=

# Comma-separated Docker Compose service names to follow.
TELEGRAM_LOG_SERVICES=backend,db

# Optional global include/exclude regex (Perl/PCRE syntax).
# TELEGRAM_LOG_INCLUDE_REGEX=ERROR|FATAL|panic
# TELEGRAM_LOG_EXCLUDE_REGEX=healthcheck|/metrics

# Optional per-service overrides. Suffix = service name UPPERCASED, hyphens → underscores.
# TELEGRAM_LOG_INCLUDE_REGEX_BACKEND=^\[ERROR\]|Unhandled
# TELEGRAM_LOG_EXCLUDE_REGEX_DB=checkpoint complete|autovacuum

# Tuning (defaults shown)
# TELEGRAM_WATCH_INTERVAL_SECONDS=5
# TELEGRAM_MAX_MESSAGE_LENGTH=4000
# TELEGRAM_API_BASE=https://api.telegram.org

# Build override
# TELEGRAM_LOG_SIDECAR_IMAGE=myapp-telegram-log-sidecar:latest
